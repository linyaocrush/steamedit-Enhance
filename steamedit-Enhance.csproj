<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>steamedit-Enhance</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <NoWarn>WFO1000;WFO0003;CA1416</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="steamedit-EnhanceTests\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Obfuscar" Version="2.2.50">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Native Rust core (steamedit-core). The kernel is mandatory — there is no managed
       fallback — so a missing toolchain or a failed build is a hard error. -->
  <PropertyGroup>
    <RustCoreDir>$(MSBuildProjectDirectory)\native\steamedit-core</RustCoreDir>
    <RustCoreDll>$(RustCoreDir)\target\release\steamedit_core.dll</RustCoreDll>
  </PropertyGroup>

  <Target Name="BuildRustCore" BeforeTargets="BeforeBuild"
          Condition="'$(OS)' == 'Windows_NT' And '$(SkipRustBuild)' != 'true' And Exists('$(RustCoreDir)\Cargo.toml')">
    <Exec Command="cargo build --release --manifest-path &quot;$(RustCoreDir)\Cargo.toml&quot;" />
  </Target>

  <Target Name="CopyRustCore" AfterTargets="Build">
    <Error Text="原生内核未生成：$(RustCoreDll) 不存在。本版本仅使用 Rust 内核，请安装 Rust 工具链后重新构建。"
           Condition="!Exists('$(RustCoreDll)')" />
    <Copy SourceFiles="$(RustCoreDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Ensure the native DLL is also placed next to the published EXE (incl. single-file publish). -->
  <Target Name="IncludeRustCoreInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup Condition="Exists('$(RustCoreDll)')">
      <ResolvedFileToPublish Include="$(RustCoreDll)">
        <RelativePath>steamedit_core.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="Obfuscar" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ObfuscarConfigPath>$(MSBuildProjectDirectory)\obfuscar.xml</ObfuscarConfigPath>
      <ObfuscarConsolePath>$(NuGetPackageRoot)obfuscar\2.2.50\tools\Obfuscar.Console.exe</ObfuscarConsolePath>
    </PropertyGroup>
    <Message Text="Obfuscar: Running obfuscation..." Importance="high" />
    <Exec Command="&quot;$(ObfuscarConsolePath)&quot; &quot;$(ObfuscarConfigPath)&quot;" ConsoleToMSBuild="true" />
    <!-- 防止再次开启属性/字段重命名：程序运行时依赖这些名字（数据绑定 / JSON / 枚举名 / 反射）。 -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { $p = '$(OutDir)obfuscated\$(AssemblyName).dll'; $s = [IO.File]::ReadAllText($p, [Text.Encoding]::GetEncoding(28591)); $missing = @(); foreach ($n in 'IsHidden','EnableCompleted','OnlyModified') { if ($s.IndexOf($n) -lt 0) { $missing += $n } }; if ($missing.Count -gt 0) { Write-Host ('OBFUSCATION CHECK FAILED: required member names were renamed: ' + ($missing -join ', ')); exit 1 }; Write-Host 'Obfuscation name check passed.' }&quot;" />
    <!-- 单文件发布：用混淆后的 DLL 覆盖原始 DLL，使 publish 流程使用混淆版本 -->
    <Copy SourceFiles="$(OutDir)obfuscated\$(AssemblyName).dll" DestinationFiles="$(OutDir)$(AssemblyName).dll" Condition="'$(PublishSingleFile)' == 'true'" />
    <Message Text="Obfuscar: Obfuscation complete - obfuscated output in $(OutDir)obfuscated\" Importance="high" />
  </Target>
</Project>
