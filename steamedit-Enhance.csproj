<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>steamedit-Enhance</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <NoWarn>WFO1000;WFO0003;CA1416</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="steamedit-EnhanceTests\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Obfuscar" Version="2.2.50">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="Obfuscar" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ObfuscarConfigPath>$(MSBuildProjectDirectory)\obfuscar.xml</ObfuscarConfigPath>
      <ObfuscarConsolePath>$(NuGetPackageRoot)obfuscar\2.2.50\tools\Obfuscar.Console.exe</ObfuscarConsolePath>
    </PropertyGroup>
    <Message Text="Obfuscar: Running obfuscation..." Importance="high" />
    <Exec Command="&quot;$(ObfuscarConsolePath)&quot; &quot;$(ObfuscarConfigPath)&quot;" ConsoleToMSBuild="true" />
    <!-- 单文件发布：用混淆后的 DLL 覆盖原始 DLL，使 publish 流程使用混淆版本 -->
    <Copy SourceFiles="$(OutDir)obfuscated\$(AssemblyName).dll" DestinationFiles="$(OutDir)$(AssemblyName).dll" Condition="'$(PublishSingleFile)' == 'true'" />
    <Message Text="Obfuscar: Obfuscation complete - obfuscated output in $(OutDir)obfuscated\" Importance="high" />
  </Target>
</Project>
