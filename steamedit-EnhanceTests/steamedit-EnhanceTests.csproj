<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>steamedit_EnhanceTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.*" />
    <PackageReference Include="MSTest.TestFramework" Version="3.*" />
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\steamedit-Enhance.csproj" />
  </ItemGroup>

  <!-- Copy the native Rust core next to the test binaries so the native codec can be exercised. -->
  <PropertyGroup>
    <RustCoreDll>$(MSBuildProjectDirectory)\..\native\steamedit-core\target\release\steamedit_core.dll</RustCoreDll>
  </PropertyGroup>
  <Target Name="CopyRustCoreTest" AfterTargets="Build">
    <Copy SourceFiles="$(RustCoreDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(RustCoreDll)')" />
  </Target>
</Project>
